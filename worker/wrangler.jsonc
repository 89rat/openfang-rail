// openfang-rail worker — honest x402 paid-tool endpoint.
// Deploy (Promoter's act): wrangler deploy
// MAINNET: targets Base MAINNET (chain 8453; USDC EIP-712 domain name "USD Coin",
// verified on-chain via name()). Paid calls require FACILITATOR_URL for on-chain
// settlement; without it the worker returns 503 on paid calls (free tier still
// works). Non-custodial throughout. (Sepolia rollback values in the comment below.)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openfang-rail",
  "main": "src/index.ts",
  // Your login has two accounts (Akrivis / code402.dev). Pinned to Akrivis —
  // where your code402 workers live. To use the other account instead, swap
  // this to 58c9d75d28034a1edd2e98ca20e096eb.
  "account_id": "3092b8a1c360e22a9f0c069bc589da23",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Smart Placement: run the worker's execution near the services it calls during
  // settlement (facilitator + Base RPC), trimming the paid-path hop. Free/validation
  // path is unaffected (already edge-served, sub-microsecond compute).
  "placement": { "mode": "smart" },
  "routes": [{ "pattern": "rail.akrivis.in", "custom_domain": true }],
  "kv_namespaces": [
    // Replay guard: used EIP-3009 nonces. Create: wrangler kv namespace create NONCES
    { "binding": "NONCES", "id": "a385d36abdc746baa0ccbbe61e221607" }
  ],
  "vars": {
    // MAINNET. Sepolia rollback: CHAIN_ID "84532", USDC "0x036CbD53842c5426634e7929541eC2318f3dCF7e", USDC_DOMAIN_NAME "USDC".
    "CHAIN_ID": "8453",
    "USDC_ADDRESS": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
    "USDC_DOMAIN_NAME": "USD Coin",
    "RECIPIENT": "0xc59c85e661d34084a7769f955d17fd38254a6235",
    // Receipt authorization chain (served in every receipt + the manifest).
    // AUTHORIZED_BY: the operator wallet that authorizes the receipt signer.
    // ATTESTATION: the exact string the operator wallet EIP-191-signed ONCE offline.
    // ATTESTATION_SIG: that wallet's personal_sign signature (public by design —
    // it proves authorization, it cannot move funds). Fill ATTESTATION_SIG, then deploy.
    "AUTHORIZED_BY": "0xc59c85e661d34084a7769f955d17fd38254a6235",
    "ATTESTATION": "openfang-rail: I authorize receipt-signer 0xae851dde8a04c9e6a3a675c6679b5e53b148c118 to issue XDR-1 receipts on my behalf. authorized_by=0xc59c85e661d34084a7769f955d17fd38254a6235",
    "ATTESTATION_SIG": "0x97e5f9ceaf22b7c9b050f9830894a82a07ef52f4d31e59eee59119ab51e0c7e150a44352cbe4e45b98f967ca6c2f09297e8af1e4816426ab26e85aa1fbdfff731c",
    "PRICE_MINOR": "999",
    "LAUNCH_MODE": "true",
    "FREE_CALLS_PER_DAY": "20",
    // Settlement facilitator — REQUIRED for paid calls on mainnet (worker calls
    // {URL}/settle). PayAI: no API key, NO upfront fee, gas-sponsored, and NO payee
    // whitelist (verified — settles to an unregistered payTo), Base mainnet USDC,
    // ~28M tx processed. Drop-in. (OpenX402 was rejected: 5 USDC upfront whitelist.)
    "FACILITATOR_URL": "https://facilitator.payai.network",
    // Failover chain (tried in order on network errors / 5xx only). NOTE: Dexter is
    // ungated but enforces a dynamic settlement floor (~1079 minor on base) — it can
    // only settle tools priced above that; the 999-minor validators have no working
    // fallback until their price clears the floor or Dexter lowers it.
    "FACILITATOR_URLS": "https://facilitator.payai.network, https://facilitator.dexter.cash",
    // Dynamic pricing (reverse/Dutch): idle price decays to the per-tool floor;
    // each settled sale bumps it up (capped at 5x). Tune WITHOUT code changes.
    "PRICE_MAX_MULT": "5",
    "PRICE_BUMP": "1.5",
    "PRICE_TAU_SECONDS": "1800",
    // Optional: public Base RPC for settlement-history-check (default publicnode)…
    "RPC_URL": "https://base-rpc.publicnode.com",
    // …and the marketplace cross-link, filled in once x402-registry is deployed:
    // "REGISTRY_URL": "https://x402-registry.<you>.workers.dev"
    "REGISTRY_URL": "https://x402-registry.akrivis.workers.dev"
  }
  // SECRET (never a var, never in this file):
  //   wrangler secret put RECEIPT_SIGNING_KEY   # 32-byte hex, a DEDICATED
  //   receipt key — NOT a fund/treasury key. Its address is published as
  //   receipt_signing_address in /.well-known/mcp.json so anyone can verify receipts.
}
